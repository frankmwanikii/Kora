 */
return [
    'host' => 'smtp.hostinger.com',
    'port' => 465,
    'encryption' => 'ssl',
    'username' => 'info@kora.fraittech.co.ke',
    'password' => 'CHANGE_ME',
    'from_email' => 'info@kora.fraittech.co.ke',
    'from_name' => 'KORA',
    'timeout' => 30,
    'transports' => [
        [
            'host' => 'smtp.hostinger.com',
            'port' => 465,
            'encryption' => 'ssl',
        ],
        [
            'host' => '127.0.0.1',
            'port' => 25,
            'encryption' => 'none',
            'username' => '',
            'password' => '',
        ],
    ],
